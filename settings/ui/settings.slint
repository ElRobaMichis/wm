// Ventana de ajustes (spike 8 + lenguaje de diseño, design.md). Misma
// funcionalidad que la versión nativa: búsqueda, perfil, lista A–Z, la app de
// la letra elegida, opciones, Guardar/Cancelar. Textos con @tr() (settings/lang).

import { Theme } from "theme.slint";
import {
    SearchField, Segmented, ToggleRow, Button, LetterList, LetterItem, SectionLabel,
    Keycap, KeyHint, PickerRow, PickField, Select
} from "components.slint";

export { LetterItem, PickerRow, Theme }

export component SettingsWindow inherits Window {
    title: @tr("wm settings");
    preferred-width: 520px;
    preferred-height: 820px;
    min-width: 440px;
    min-height: 640px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.t-body;

    in property <[LetterItem]> items;
    // Selector de apps (plan-apps.md §4).
    in property <[PickerRow]> picker-rows;
    in property <string> choice-name;
    // v1.1: la regla "al abrir" de la letra elegida.
    in property <bool> choice-assigned;
    in property <[string]> open-options;
    in-out property <int> open-choice;
    callback open-chosen(int);
    // v1.2: el escritorio donde se abre (0 = el que estés).
    in-out property <int> desk-choice;
    callback desk-chosen(int);
    out property <[string]> desk-options: [
        @tr("The one you are on"), @tr("Desk 1"), @tr("Desk 2"), @tr("Desk 3"), @tr("Desk 4")
    ];
    out property <[string]> open-labels: [
        @tr("Do nothing"), @tr("Left half"), @tr("Right half"), @tr("Maximized"), @tr("Centered")
    ];
    in property <bool> catalog-loading;
    in-out property <bool> picking: false;
    in-out property <string> picker-query;
    in property <int> assigned;
    in property <int> total: 26;
    in property <bool> dirty;
    in property <bool> bench-mark;
    // Lo que todavía no hace nada (hoy solo el perfil) queda
    // escondido: ver funciones-ocultas.md. Con `true`
    // vuelve a verse tal cual.
    in property <bool> show-unfinished: false;
    in-out property <int> selected: 0;
    // v1.1: pestaña 0 = letras, 1 = opciones.
    in-out property <int> tab: 0;
    property <int> focus-search: 0;
    in-out property <string> query;
    in-out property <int> profile: 0;
    in-out property <bool> focus-border: true;
    in-out property <bool> mouse-follows: false;
    in-out property <bool> animations: true;
    // v1.2 (plan-v1.2.md §2 y §6).
    in-out property <bool> usage-log: false;
    in-out property <bool> tips: true;
    in-out property <bool> notices: true;
    // v1.1: espacio entre ventanas (px) y abrir en la pantalla del puntero.
    in-out property <int> gap-px: 0;
    in property <[string]> gap-options;
    in-out property <int> gap-choice: 0;
    callback gap-chosen(int);
    out property <string> no-gap-text: @tr("No space");
    in-out property <bool> open-on-pointer: false;
    in property <bool> multi-monitor: false;
    in property <string> selected-letter;
    // v1.2: el aviso al elegir una app (plan-v1.2.md §3); vacías = ocultas.
    in property <string> moved-app;
    in property <string> moved-old;
    in property <string> lost-apps;
    // Textos que arma el código en Rust, traducidos acá.
    out property <string> free-text: @tr("Free");
    out property <string> none-text: @tr("None");

    callback search(string);
    callback select(int);
    callback picker-open();
    callback picker-search(string);
    callback picker-choose(int);
    // Enter en la búsqueda: la primera app de la lista.
    callback picker-enter();
    out property <string> open-text: @tr("Open now");
    out property <string> all-text: @tr("All apps");
    callback save();
    // Cambió una opción (para habilitar Guardar).
    callback options-changed();
    changed focus-border => { root.options-changed(); }
    changed mouse-follows => { root.options-changed(); }
    changed animations => { root.options-changed(); }
    changed notices => { root.options-changed(); }
    changed open-on-pointer => { root.options-changed(); }
    changed usage-log => { root.options-changed(); }
    changed tips => { root.options-changed(); }
    callback cancel();
    pure callback find-letter(string) -> int;

    FocusScope {
        // Atajos de toda la ventana: Esc cierra, Ctrl+S guarda, / busca.
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                if (root.dirty) {
                    root.save();
                }
                return accept;
            }
            if (event.text == "/") {
                root.tab = 0;
                root.focus-search += 1;
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: Theme.s6;
            spacing: 0;

            // Encabezado: título y contador (número grande, unidad en gris).
            HorizontalLayout {
                spacing: Theme.s3;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: @tr("Apps and keys");
                        font-family: Theme.font;
                        font-size: Theme.t-title;
                        font-weight: Theme.w-strong;
                        color: Theme.text;
                    }
                    Text {
                        text: @tr("Caps plus a letter opens its app.");
                        color: Theme.text-2;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                // Número y "unidad" en la misma línea, alineados abajo.
                VerticalLayout {
                    alignment: start;
                    accessible-role: text;
                    accessible-label: @tr("{n} letter assigned" | "{n} letters assigned" % root.assigned);
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.assigned;
                            font-family: Theme.font;
                            font-size: Theme.t-title;
                            font-weight: Theme.w-strong;
                            color: Theme.text;
                            vertical-alignment: bottom;
                            accessible-role: none;
                        }
                        Text {
                            text: "/ " + root.total;
                            color: Theme.text-2;
                            vertical-alignment: bottom;
                            accessible-role: none;
                        }
                    }
                }
            }

            Rectangle { height: Theme.s4; }

            // v1.1: dos pestañas (plan-v1.1.md §4).
            Segmented {
                options: [@tr("Letters"), @tr("Options")];
                label: @tr("Section");
                current <=> root.tab;
            }

            if root.tab == 0: VerticalLayout {
                vertical-stretch: 1;
                // "/" pide el foco para la búsqueda.
                property <int> focus-req: root.focus-search;
                changed focus-req => {
                    search.focus();
                }
                Rectangle { height: Theme.s4; }

                search := SearchField {
                    placeholder: @tr("Search an app or a letter");
                    label: @tr("Search");
                    shortcut: "/";
                    text <=> root.query;
                    edited(text) => {
                        root.search(text);
                    }
                    init => {
                        self.focus();
                    }
                }

                // Perfil "Apps primero / Ventanas primero" (funciones-ocultas.md §1).
                if root.show-unfinished: VerticalLayout {
                    Rectangle { height: Theme.s6; }
                    SectionLabel {
                        text: @tr("What do you want closest at hand?");
                    }
                    Rectangle { height: Theme.s2; }
                    Segmented {
                        options: [@tr("Apps first"), @tr("Windows first")];
                        label: @tr("What do you want closest at hand?");
                        current <=> root.profile;
                    }
                }

                Rectangle { height: Theme.s6; }

                HorizontalLayout {
                    SectionLabel {
                        text: @tr("Letters");
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: @tr("↑ ↓ or type a letter");
                        color: Theme.text-3;
                        font-size: Theme.t-small;
                    }
                }
                Rectangle { height: Theme.s2; }

                // Tarjeta con la lista (radio 14 = fila 8 + relleno 6).
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 5 * Theme.h-row + 2 * Theme.card-pad;
                    border-radius: Theme.r-card;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    VerticalLayout {
                        padding: Theme.card-pad;
                        LetterList {
                            items: root.items;
                            label: @tr("Letters");
                            free-text: root.free-text;
                            current <=> root.selected;
                            current-changed(index) => {
                                root.select(index);
                            }
                            find-letter(text) => {
                                return root.find-letter(text);
                            }
                        }
                    }
                }

                Rectangle { height: Theme.s3; }

                // La app de la letra elegida.
                HorizontalLayout {
                    spacing: Theme.s3;
                    VerticalLayout {
                        alignment: center;
                        Keycap {
                            letter: root.selected-letter;
                        }
                    }
                    Text {
                        text: @tr("opens");
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                    PickField {
                        horizontal-stretch: 1;
                        text: root.choice-name;
                        label: @tr("App for “{}”", root.selected-letter);
                        open => {
                            root.picker-query = "";
                            root.picker-open();
                            root.picking = true;
                        }
                    }
                }

                // v1.1: dónde va la app al abrirse (plan-v1.1.md).
                if root.choice-assigned: VerticalLayout {
                    Rectangle { height: Theme.s2; }
                    GridLayout {
                        spacing: Theme.s3;
                        Row {
                            Text {
                                text: @tr("When it opens");
                                color: Theme.text-2;
                                vertical-alignment: center;
                            }
                            Select {
                                horizontal-stretch: 1;
                                model: root.open-options;
                                window-height: root.height;
                                label: @tr("When it opens");
                                current <=> root.open-choice;
                                selected(index) => {
                                    root.open-chosen(index);
                                }
                            }
                        }
                        // v1.2 (plan-v1.2.md §5): wm va con la ventana.
                        Row {
                            Text {
                                text: @tr("On desk");
                                color: Theme.text-2;
                                vertical-alignment: center;
                            }
                            Select {
                                horizontal-stretch: 1;
                                model: root.desk-options;
                                window-height: root.height;
                                label: @tr("On desk");
                                current <=> root.desk-choice;
                                selected(index) => {
                                    root.desk-chosen(index);
                                }
                            }
                        }
                    }
                }

                // v1.2: una app, una letra (plan-v1.2.md §3).
                if root.moved-app != "": VerticalLayout {
                    Rectangle { height: Theme.s2; }
                    Text {
                        text: @tr("{} was on {}. Now it is only on {}.", root.moved-app, root.moved-old, root.selected-letter);
                        color: Theme.text-2;
                        font-size: Theme.t-small;
                        wrap: word-wrap;
                    }
                }
                if root.lost-apps != "": VerticalLayout {
                    Rectangle { height: Theme.s2; }
                    Text {
                        text: @tr("Caps + {} will no longer go to: {} (open now). Give them another letter if you use them.", root.selected-letter, root.lost-apps);
                        color: Theme.text-2;
                        font-size: Theme.t-small;
                        wrap: word-wrap;
                    }
                }
            }

            if root.tab == 1: VerticalLayout {
                vertical-stretch: 1;
                Rectangle { height: Theme.s4; }
                // v1.1: las ventanas (plan-v1.1.md §9).
                SectionLabel {
                    text: @tr("Windows");
                }
                Rectangle { height: Theme.s2; }
                Rectangle {
                    border-radius: Theme.r-card;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: Theme.card-pad;
                        HorizontalLayout {
                            padding-left: Theme.s3;
                            padding-right: Theme.s3;
                            spacing: Theme.s3;
                            height: 52px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: @tr("Space between windows");
                                    color: Theme.text;
                                }
                                Text {
                                    text: @tr("Around halves and corners, and against the screen edges.");
                                    color: Theme.text-2;
                                    font-size: Theme.t-small;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Select {
                                    width: 140px;
                                    model: root.gap-options;
                                    window-height: root.height;
                                    label: @tr("Space between windows");
                                    current <=> root.gap-choice;
                                    selected(index) => {
                                        root.gap-chosen(index);
                                    }
                                }
                            }
                        }
                        if root.multi-monitor: ToggleRow {
                            text: @tr("Open on the pointer's screen");
                            detail: @tr("Apps with a “When it opens” rule go to the screen where the pointer is.");
                            checked <=> root.open-on-pointer;
                        }
                    }
                }
                Rectangle { height: Theme.s6; }
                SectionLabel {
                    text: @tr("Options");
                }
                Rectangle { height: Theme.s2; }
                Rectangle {
                    border-radius: Theme.r-card;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: Theme.card-pad;
                        ToggleRow {
                            text: @tr("Focus border");
                            detail: @tr("A 2 px line around the active window.");
                            checked <=> root.focus-border;
                        }
                        ToggleRow {
                            text: @tr("Mouse follows focus");
                            detail: @tr("When you switch apps, the pointer goes with it.");
                            checked <=> root.mouse-follows;
                        }
                        ToggleRow {
                            text: @tr("Animate windows");
                            detail: @tr("Short movements, no bounce.");
                            checked <=> root.animations;
                        }
                        ToggleRow {
                            text: @tr("On-screen notices");
                            detail: @tr("A short message when a key can't do anything.");
                            checked <=> root.notices;
                        }
                        ToggleRow {
                            text: @tr("Shortcut tips");
                            detail: @tr("When you go to an app with Alt+Tab or the taskbar, it reminds you of its letter.");
                            checked <=> root.tips;
                        }
                        ToggleRow {
                            text: @tr("Usage log");
                            detail: @tr("Counts which shortcuts you use, only on this PC. Nothing is sent anywhere.");
                            checked <=> root.usage-log;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }

            Rectangle { height: Theme.s6; }

            // Pie: atajos en gris a la izquierda, botones a la derecha.
            HorizontalLayout {
                spacing: Theme.s2;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        KeyHint { text: "Esc"; }
                    }
                    Text {
                        text: @tr("close");
                        color: Theme.text-3;
                        font-size: Theme.t-small;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 6px; }
                    VerticalLayout {
                        alignment: center;
                        KeyHint { text: "Ctrl S"; }
                    }
                    Text {
                        text: @tr("save");
                        color: Theme.text-3;
                        font-size: Theme.t-small;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Cancel");
                    clicked => {
                        root.cancel();
                    }
                }
                Button {
                    text: @tr("Save");
                    primary: true;
                    enabled: root.dirty;
                    clicked => {
                        root.save();
                    }
                }
            }
        }
    }

    // Selector de apps: cubre la ventana (sin ventana flotante: lugar para
    // una lista larga y foco simple). Esc o Cancelar lo cierran.
    if root.picking: Rectangle {
        background: Theme.bg;
        TouchArea { }
        picker-keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.picking = false;
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding: Theme.s6;
                spacing: Theme.s3;
                HorizontalLayout {
                    spacing: Theme.s3;
                    VerticalLayout {
                        alignment: center;
                        Keycap {
                            letter: root.selected-letter;
                        }
                    }
                    Text {
                        text: @tr("App for “{}”", root.selected-letter);
                        color: Theme.text;
                        font-size: Theme.t-body;
                        font-weight: Theme.w-strong;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: @tr("Cancel");
                        clicked => {
                            root.picking = false;
                        }
                    }
                }
                picker-field := SearchField {
                    init => {
                        self.focus();
                    }
                    placeholder: @tr("Search an app");
                    label: @tr("Search an app");
                    text <=> root.picker-query;
                    edited(text) => {
                        root.picker-search(text);
                    }
                    accepted => {
                        root.picker-enter();
                        root.picking = false;
                    }
                }
                if root.catalog-loading: Text {
                    text: @tr("Loading the installed apps…");
                    color: Theme.text-3;
                    font-size: Theme.t-small;
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.r-card;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    Flickable {
                        x: Theme.card-pad;
                        y: Theme.card-pad;
                        width: parent.width - 2 * Theme.card-pad;
                        height: parent.height - 2 * Theme.card-pad;
                        content-height: root.picker-rows.length * 32px;
                        for row[i] in root.picker-rows: Rectangle {
                            y: i * 32px;
                            height: 32px;
                            border-radius: Theme.r-row;
                            background: row.kind != 0 && row-ta.has-hover ? Theme.fill : transparent;
                            Text {
                                x: Theme.s3;
                                width: parent.width * 0.62;
                                height: parent.height;
                                text: row.name;
                                color: row.kind == 0 ? Theme.text-2 : Theme.text;
                                font-size: row.kind == 0 ? Theme.t-small : Theme.t-body;
                                font-weight: row.kind == 0 ? Theme.w-strong : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                x: parent.width * 0.62 + Theme.s3;
                                width: parent.width * 0.38 - 2 * Theme.s3;
                                height: parent.height;
                                text: row.detail;
                                color: Theme.text-3;
                                font-size: Theme.t-small;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                            row-ta := TouchArea {
                                enabled: row.kind != 0;
                                clicked => {
                                    root.picker-choose(i);
                                    root.picking = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Marca para medir el arranque (wm-bench settings).
    if root.bench-mark: Rectangle {
        x: 0;
        y: 0;
        width: 48px;
        height: 64px;
        background: #ff00ff;
    }
}
