// Ventana de ajustes (spike 8 + lenguaje de diseño, design.md). Misma
// funcionalidad que la versión nativa: búsqueda, perfil, lista A–Z, la app de
// la letra elegida, opciones, Guardar/Cancelar. Textos con @tr() (settings/lang).

import { Theme } from "theme.slint";
import {
    SearchField, Segmented, ToggleRow, Button, Select, LetterList, LetterItem, SectionLabel,
    Keycap, KeyHint
} from "components.slint";

export { LetterItem, Theme }

export component SettingsWindow inherits Window {
    title: @tr("wm settings");
    preferred-width: 520px;
    preferred-height: 820px;
    min-width: 440px;
    min-height: 640px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.t-body;

    in property <[LetterItem]> items;
    in property <[string]> apps;
    in property <int> assigned;
    in property <int> total: 26;
    in property <bool> dirty;
    in property <bool> bench-mark;
    in-out property <int> selected: 0;
    in-out property <int> choice: 0;
    in-out property <string> query;
    in-out property <int> profile: 0;
    in-out property <bool> focus-border: true;
    in-out property <bool> mouse-follows: false;
    in-out property <bool> animations: true;
    in property <string> selected-letter;
    // Textos que arma el código en Rust, traducidos acá.
    out property <string> free-text: @tr("Free");
    out property <string> none-text: @tr("None");

    callback search(string);
    callback select(int);
    callback choose(int);
    callback save();
    callback cancel();
    pure callback find-letter(string) -> int;

    forward-focus: search;

    FocusScope {
        // Atajos de toda la ventana: Esc cierra, Ctrl+S guarda, / busca.
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.modifiers.control && (event.text == "s" || event.text == "S")) {
                if (root.dirty) {
                    root.save();
                }
                return accept;
            }
            if (event.text == "/" && !search.has-focus) {
                search.focus();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: Theme.s6;
            spacing: 0;

            // Encabezado: título y contador (número grande, unidad en gris).
            HorizontalLayout {
                spacing: Theme.s3;
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: @tr("Apps and keys");
                        font-family: Theme.font-display;
                        font-size: Theme.t-title;
                        font-weight: Theme.w-strong;
                        color: Theme.text;
                    }
                    Text {
                        text: @tr("Caps plus a letter opens its app.");
                        color: Theme.text-2;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                // Número y "unidad" en la misma línea, alineados abajo.
                VerticalLayout {
                    alignment: start;
                    accessible-role: text;
                    accessible-label: @tr("{n} letter assigned" | "{n} letters assigned" % root.assigned);
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.assigned;
                            font-family: Theme.font-display;
                            font-size: Theme.t-title;
                            font-weight: Theme.w-strong;
                            color: Theme.text;
                            vertical-alignment: bottom;
                            accessible-role: none;
                        }
                        Text {
                            text: "/ " + root.total;
                            color: Theme.text-2;
                            vertical-alignment: bottom;
                            accessible-role: none;
                        }
                    }
                }
            }

            Rectangle { height: Theme.s4; }

            search := SearchField {
                placeholder: @tr("Search an app or a letter");
                label: @tr("Search");
                shortcut: "/";
                text <=> root.query;
                edited(text) => {
                    root.search(text);
                }
            }

            Rectangle { height: Theme.s6; }

            SectionLabel {
                text: @tr("What do you want closest at hand?");
            }
            Rectangle { height: Theme.s2; }
            Segmented {
                options: [@tr("Apps first"), @tr("Windows first")];
                label: @tr("What do you want closest at hand?");
                current <=> root.profile;
            }

            Rectangle { height: Theme.s6; }

            HorizontalLayout {
                SectionLabel {
                    text: @tr("Letters");
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: @tr("↑ ↓ or type a letter");
                    color: Theme.text-3;
                    font-size: Theme.t-small;
                }
            }
            Rectangle { height: Theme.s2; }

            // Tarjeta con la lista (radio 14 = fila 8 + relleno 6).
            Rectangle {
                vertical-stretch: 1;
                min-height: 5 * Theme.h-row + 2 * Theme.card-pad;
                border-radius: Theme.r-card;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                VerticalLayout {
                    padding: Theme.card-pad;
                    LetterList {
                        items: root.items;
                        label: @tr("Letters");
                        free-text: root.free-text;
                        current <=> root.selected;
                        current-changed(index) => {
                            root.select(index);
                        }
                        find-letter(text) => {
                            return root.find-letter(text);
                        }
                    }
                }
            }

            Rectangle { height: Theme.s3; }

            // La app de la letra elegida.
            HorizontalLayout {
                spacing: Theme.s3;
                VerticalLayout {
                    alignment: center;
                    Keycap {
                        letter: root.selected-letter;
                    }
                }
                Text {
                    text: @tr("opens");
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
                Select {
                    horizontal-stretch: 1;
                    model: root.apps;
                    label: @tr("App for “{}”", root.selected-letter);
                    current <=> root.choice;
                    selected(index) => {
                        root.choose(index);
                    }
                }
            }

            Rectangle { height: Theme.s6; }

            SectionLabel {
                text: @tr("Options");
            }
            Rectangle { height: Theme.s2; }
            Rectangle {
                border-radius: Theme.r-card;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: Theme.card-pad;
                    ToggleRow {
                        text: @tr("Focus border");
                        detail: @tr("A 2 px line around the active window.");
                        checked <=> root.focus-border;
                    }
                    ToggleRow {
                        text: @tr("Mouse follows focus");
                        detail: @tr("When you switch apps, the pointer goes with it.");
                        checked <=> root.mouse-follows;
                    }
                    ToggleRow {
                        text: @tr("Animate windows");
                        detail: @tr("Short movements, no bounce.");
                        checked <=> root.animations;
                    }
                }
            }

            Rectangle { height: Theme.s6; }

            // Pie: atajos en gris a la izquierda, botones a la derecha.
            HorizontalLayout {
                spacing: Theme.s2;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        KeyHint { text: "Esc"; }
                    }
                    Text {
                        text: @tr("close");
                        color: Theme.text-3;
                        font-size: Theme.t-small;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 6px; }
                    VerticalLayout {
                        alignment: center;
                        KeyHint { text: "Ctrl S"; }
                    }
                    Text {
                        text: @tr("save");
                        color: Theme.text-3;
                        font-size: Theme.t-small;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Cancel");
                    clicked => {
                        root.cancel();
                    }
                }
                Button {
                    text: @tr("Save");
                    primary: true;
                    enabled: root.dirty;
                    clicked => {
                        root.save();
                    }
                }
            }
        }
    }

    // Marca para medir el arranque (wm-bench settings).
    if root.bench-mark: Rectangle {
        x: 0;
        y: 0;
        width: 48px;
        height: 64px;
        background: #ff00ff;
    }
}
