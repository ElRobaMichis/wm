// Componentes del lenguaje de diseño (design.md §4). Todos usan los tokens de
// Theme, tienen foco visible (anillo de acento de 2 px) y rol de
// accesibilidad propio: el Narrador los anuncia como lo que son.

import { Theme } from "theme.slint";

// Anillo de foco: 2 px de acento por fuera, con el radio del control + 3.
export component FocusRing inherits Rectangle {
    in property <length> radius;
    border-radius: self.radius + 3px;
    border-width: 2px;
    border-color: Theme.accent;
    background: transparent;
}

// Tecla: el sello visual de wm (Caps + letra se ve como una tecla).
export component Keycap inherits Rectangle {
    in property <string> letter;
    in property <bool> active;
    width: 22px;
    height: 22px;
    border-radius: Theme.r-key;
    border-width: 1px;
    border-color: self.active ? Theme.accent : Theme.border;
    background: self.active ? Theme.accent : Theme.fill;
    accessible-role: none;
    Text {
        text: root.letter;
        color: root.active ? Theme.on-accent : Theme.text;
        font-family: Theme.font;
        font-size: Theme.t-small;
        font-weight: Theme.w-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Tecla chica de atajo (gris), a la derecha de campos y filas.
export component KeyHint inherits Rectangle {
    in property <string> text;
    height: 18px;
    width: max(18px, label.preferred-width + 10px);
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: none;
    label := Text {
        text: root.text;
        color: Theme.text-2;
        font-family: Theme.font;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Título de sección: chico, semibold, gris (referencias 6 y 8).
export component SectionLabel inherits Text {
    color: Theme.text-2;
    font-family: Theme.font;
    font-size: Theme.t-small;
    font-weight: Theme.w-strong;
}

export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in property <string> label;
    in property <string> shortcut;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    // Enter.
    callback accepted();

    height: Theme.h-field;
    border-radius: Theme.r-row;
    background: Theme.fill;
    forward-focus: input;

    Path {
        x: 10px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: Theme.text-2;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 7 2.75 A 4.25 4.25 0 1 1 7 11.25 A 4.25 4.25 0 1 1 7 2.75 Z M 10.2 10.2 L 13.25 13.25";
        accessible-role: none;
    }

    if input.text == "": Text {
        x: 34px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.text-3;
        font-family: Theme.font;
        font-size: Theme.t-body;
        accessible-role: none;
    }

    input := TextInput {
        x: 34px;
        width: parent.width - 34px - 36px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        color: Theme.text;
        selection-background-color: Theme.accent;
        font-family: Theme.font;
        font-size: Theme.t-body;
        accessible-label: root.label;
        accessible-placeholder-text: root.placeholder;
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted();
        }
    }

    if !input.has-focus && root.shortcut != "": KeyHint {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        text: root.shortcut;
    }

    if input.has-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: Theme.r-row;
    }
}

// Control segmentado (referencias 4 y 7): riel gris, píldora que se desliza.
export component Segmented {
    in property <[string]> options;
    in property <string> label;
    in-out property <int> current: 0;
    callback changed(int);

    function select(i: int) {
        if (i != root.current) {
            root.current = i;
            root.changed(i);
        }
    }

    private property <length> seg-w: (self.width - 4px) / max(1, root.options.length);
    height: Theme.h-field;
    accessible-role: radio-group;
    accessible-label: root.label;
    forward-focus: fs;

    track := Rectangle {
        border-radius: self.height / 2;
        background: Theme.fill;
    }

    Rectangle {
        x: 2px + root.current * root.seg-w;
        y: 2px;
        width: root.seg-w;
        height: parent.height - 4px;
        border-radius: self.height / 2;
        background: Theme.dark ? Theme.fill-strong : Theme.surface;
        border-width: Theme.dark ? 0px : 1px;
        border-color: Theme.border;
        drop-shadow-blur: Theme.dark ? 0px : 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.shadow;
        animate x { duration: Theme.motion; easing: ease-out; }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow) {
                root.select(min(root.current + 1, root.options.length - 1));
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.select(max(root.current - 1, 0));
                return accept;
            }
            reject
        }
    }

    for option[i] in root.options: Rectangle {
        x: 2px + i * root.seg-w;
        y: 2px;
        width: root.seg-w;
        height: parent.height - 4px;
        accessible-role: radio-button;
        accessible-label: option;
        accessible-checkable: true;
        accessible-checked: i == root.current;
        accessible-action-default => {
            root.select(i);
        }
        Text {
            text: option;
            color: i == root.current ? Theme.text : Theme.text-2;
            font-family: Theme.font;
            font-size: Theme.t-body;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
            animate color { duration: Theme.motion; }
        }
        TouchArea {
            clicked => {
                root.select(i);
                fs.focus();
            }
        }
    }

    if fs.has-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: self.height / 2 - 3px;
    }
}

// Interruptor en fila: título, detalle en gris, riel a la derecha.
export component ToggleRow {
    in property <string> text;
    in property <string> detail;
    in-out property <bool> checked;
    callback toggled(bool);

    function flip() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    height: 52px;
    accessible-role: switch;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.flip();
    }
    forward-focus: fs;

    Rectangle {
        border-radius: Theme.r-row;
        background: ta.has-hover ? Theme.fill : transparent;
        animate background { duration: Theme.motion; }
    }

    VerticalLayout {
        x: Theme.s3;
        width: parent.width - 2 * Theme.s3 - 34px - Theme.s3;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.text;
            color: Theme.text;
            font-family: Theme.font;
            font-size: Theme.t-body;
            accessible-role: none;
        }
        Text {
            text: root.detail;
            color: Theme.text-2;
            font-family: Theme.font;
            font-size: Theme.t-small;
            accessible-role: none;
        }
    }

    Rectangle {
        x: parent.width - Theme.s3 - 34px;
        y: (parent.height - 20px) / 2;
        width: 34px;
        height: 20px;
        border-radius: 10px;
        background: root.checked ? Theme.accent : Theme.track-off;
        animate background { duration: Theme.motion; }
        Rectangle {
            x: root.checked ? parent.width - 18px : 2px;
            y: 2px;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: Theme.knob;
            drop-shadow-blur: 2px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: #00000033;
            animate x { duration: Theme.motion; easing: ease-out; }
        }
    }

    ta := TouchArea {
        clicked => {
            root.flip();
            fs.focus();
        }
    }

    fs := FocusScope {
        // El TouchArea de arriba da el foco: si el FocusScope lo tomara solo,
        // se quedaría con el primer clic y el control no respondería.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.flip();
                return accept;
            }
            reject
        }
    }

    if fs.has-focus: FocusRing {
        x: -1px;
        y: -1px;
        width: parent.width + 2px;
        height: parent.height + 2px;
        radius: Theme.r-row - 2px;
    }
}

// Botón: principal (píldora clara en oscuro) o secundario (relleno sutil).
export component Button {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    function press() {
        if (root.enabled) {
            root.clicked();
        }
    }

    height: Theme.h-field;
    min-width: max(88px, label.preferred-width + 2 * Theme.s4);
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.press();
    }
    forward-focus: fs;

    Rectangle {
        border-radius: self.height / 2;
        background: !root.enabled ? Theme.fill
            : root.primary ? (ta.pressed ? Theme.text-2 : Theme.primary)
            : (ta.has-hover ? Theme.fill-strong : Theme.fill);
        animate background { duration: Theme.motion; }
    }
    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.text-3 : root.primary ? Theme.on-primary : Theme.text;
        font-family: Theme.font;
        font-size: Theme.t-body;
        font-weight: Theme.w-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.press();
            fs.focus();
        }
    }
    fs := FocusScope {
        // El TouchArea de arriba da el foco: si el FocusScope lo tomara solo,
        // se quedaría con el primer clic y el control no respondería.
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.press();
                return accept;
            }
            reject
        }
    }
    if fs.has-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: self.height / 2 - 3px;
    }
}

// Desplegable: el valor y una flecha; abre una tarjeta flotante (la única
// sombra de la pantalla). Con flechas arriba/abajo cambia sin abrir.
// La tarjeta se abre hacia donde haya más lugar y nunca pasa el borde de la
// ventana (si no, se cortaba abajo).
export component Select {
    in property <[string]> model;
    in property <string> label;
    in-out property <int> current;
    // Alto de la ventana: para saber cuánto lugar hay abajo y arriba.
    in property <length> window-height: 100000px;
    callback selected(int);

    private property <length> gap: Theme.s1;
    private property <length> space-below: root.window-height - root.absolute-position.y - root.height - root.gap - Theme.s2;
    private property <length> space-above: root.absolute-position.y - root.gap - Theme.s2;
    private property <length> wanted: min(320px, root.model.length * 32px + 2 * Theme.card-pad);
    private property <bool> open-up: root.space-below < root.wanted && root.space-above > root.space-below;
    private property <length> popup-height: min(root.wanted, root.open-up ? root.space-above : root.space-below);

    function choose(i: int) {
        root.current = i;
        root.selected(i);
    }

    height: Theme.h-field;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.model[root.current];
    accessible-expandable: true;
    accessible-action-default => {
        popup.show();
    }
    accessible-action-expand => {
        popup.show();
    }
    forward-focus: fs;

    Rectangle {
        border-radius: Theme.r-row;
        background: ta.has-hover ? Theme.fill-strong : Theme.fill;
        animate background { duration: Theme.motion; }
    }
    Text {
        x: Theme.s3;
        width: parent.width - Theme.s3 - 32px;
        height: parent.height;
        text: root.model[root.current];
        color: Theme.text;
        font-family: Theme.font;
        font-size: Theme.t-body;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    Path {
        x: parent.width - 26px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: Theme.text-2;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 4.5 6.5 L 8 10 L 11.5 6.5";
        accessible-role: none;
    }
    ta := TouchArea {
        clicked => {
            popup.show();
            fs.focus();
        }
    }
    fs := FocusScope {
        // El TouchArea de arriba da el foco: si el FocusScope lo tomara solo,
        // se quedaría con el primer clic y el control no respondería.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.choose(min(root.current + 1, root.model.length - 1));
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.choose(max(root.current - 1, 0));
                return accept;
            }
            if (event.text == " " || event.text == Key.Return) {
                popup.show();
                return accept;
            }
            reject
        }
    }
    if fs.has-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: Theme.r-row;
    }

    popup := PopupWindow {
        x: 0;
        y: root.open-up ? -root.popup-height - root.gap : root.height + root.gap;
        width: root.width;
        height: root.popup-height;
        Rectangle {
            border-radius: Theme.r-card;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow;
            Flickable {
                x: Theme.card-pad;
                y: Theme.card-pad;
                width: parent.width - 2 * Theme.card-pad;
                height: parent.height - 2 * Theme.card-pad;
                content-height: root.model.length * 32px;
                for item[i] in root.model: Rectangle {
                    y: i * 32px;
                    height: 32px;
                    border-radius: Theme.r-row;
                    background: i == root.current ? Theme.fill-strong : row-ta.has-hover ? Theme.fill : transparent;
                    Text {
                        x: Theme.s3;
                        height: parent.height;
                        text: item;
                        color: Theme.text;
                        font-family: Theme.font;
                        font-size: Theme.t-body;
                        vertical-alignment: center;
                    }
                    row-ta := TouchArea {
                        clicked => {
                            root.choose(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Una fila de la lista de letras.
export struct LetterItem {
    letter: string,
    name: string,
    exe: string,
    assigned: bool,
}

// Lista de letras: tecla, app y ejecutable a la derecha. Flechas,
// Inicio/Fin y escribir una letra salta a esa fila.
export component LetterList {
    in property <[LetterItem]> items;
    in property <string> label;
    in property <string> free-text;
    in-out property <int> current;
    callback current-changed(int);
    // Índice de la fila con esa letra (-1 si no hay): lo resuelve Rust.
    pure callback find-letter(string) -> int;

    function go(i: int) {
        if (root.items.length == 0) {
            return;
        }
        root.current = max(0, min(i, root.items.length - 1));
        root.current-changed(root.current);
        // Mantener la fila elegida a la vista.
        if (root.current * Theme.h-row < -flick.content-y) {
            flick.content-y = -root.current * Theme.h-row;
        }
        if ((root.current + 1) * Theme.h-row > -flick.content-y + flick.height) {
            flick.content-y = -((root.current + 1) * Theme.h-row - flick.height);
        }
    }

    accessible-role: list;
    accessible-label: root.label;
    forward-focus: fs;

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                root.go(root.current + 1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.go(root.current - 1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.go(0);
                return accept;
            }
            if (event.text == Key.End) {
                root.go(root.items.length - 1);
                return accept;
            }
            // Escribir una letra salta a su fila.
            if (event.modifiers.control || event.modifiers.alt) {
                return reject;
            }
            let found = root.find-letter(event.text);
            if (found >= 0) {
                root.go(found);
                return accept;
            }
            reject
        }
    }

    // Barra de desplazamiento fina (solo si hay más filas que lugar).
    if flick.content-height > flick.height: Rectangle {
        x: parent.width - 3px;
        y: -flick.content-y * flick.height / flick.content-height;
        width: 3px;
        height: max(24px, flick.height * flick.height / flick.content-height);
        border-radius: 1.5px;
        background: Theme.fill-strong;
    }

    flick := Flickable {
        width: parent.width - 6px;
        content-height: root.items.length * Theme.h-row;
        for item[i] in root.items: Rectangle {
            y: i * Theme.h-row;
            height: Theme.h-row;
            border-radius: Theme.r-row;
            background: i == root.current ? Theme.fill-strong : row-ta.has-hover ? Theme.fill : transparent;
            animate background { duration: Theme.motion; }
            accessible-role: list-item;
            accessible-label: item.letter + ", " + (item.assigned ? item.name : root.free-text);
            accessible-item-index: i;
            accessible-item-count: root.items.length;
            accessible-item-selectable: true;
            accessible-item-selected: i == root.current;
            accessible-action-default => {
                root.go(i);
            }
            Keycap {
                x: Theme.s2;
                y: (parent.height - self.height) / 2;
                letter: item.letter;
                active: i == root.current && fs.has-focus;
            }
            Text {
                x: Theme.s2 + 22px + Theme.s3;
                width: parent.width / 2;
                height: parent.height;
                text: item.assigned ? item.name : root.free-text;
                color: item.assigned ? Theme.text : Theme.text-3;
                font-family: Theme.font;
                font-size: Theme.t-body;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                x: parent.width - self.width - Theme.s3;
                height: parent.height;
                text: item.exe;
                color: Theme.text-3;
                font-family: Theme.font;
                font-size: Theme.t-small;
                vertical-alignment: center;
                horizontal-alignment: right;
                accessible-role: none;
            }
            row-ta := TouchArea {
                clicked => {
                    root.go(i);
                    fs.focus();
                }
            }
        }
    }
}

// Una fila del selector de apps (plan-apps.md §4): título de sección
// (kind 0), "Ninguna" (kind 2) o una app (kind 1).
export struct PickerRow {
    kind: int,
    name: string,
    detail: string,
}

// El valor de la letra elegida; un clic abre el selector.
export component PickField {
    in property <string> text;
    in property <string> label;
    callback open();

    height: Theme.h-field;
    accessible-role: button;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-action-default => {
        root.open();
    }
    forward-focus: fs;

    Rectangle {
        border-radius: Theme.r-row;
        background: ta.has-hover ? Theme.fill-strong : Theme.fill;
        animate background { duration: Theme.motion; }
    }
    Text {
        x: Theme.s3;
        width: parent.width - Theme.s3 - 32px;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-family: Theme.font;
        font-size: Theme.t-body;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    Path {
        x: parent.width - 26px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: Theme.text-2;
        stroke-width: 1.5px;
        fill: transparent;
        commands: "M 4.5 6.5 L 8 10 L 11.5 6.5";
        accessible-role: none;
    }
    ta := TouchArea {
        clicked => {
            root.open();
        }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return || event.text == Key.DownArrow) {
                root.open();
                return accept;
            }
            reject
        }
    }
    if fs.has-focus: FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: Theme.r-row;
    }
}
